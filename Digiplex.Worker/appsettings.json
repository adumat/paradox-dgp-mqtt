{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Digiplex": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/digiplex-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Serial": {
    "PortName": "/dev/ttyUSB0",
    "BaudRate": 19200,
    "Password": "0000",
    "PollIntervalMs": 1000,
    "ReadTimeoutMs": 1000,
    "MaxRetries": 5,
    "ZoneCount": 48
  },
  "Partitions": {
    "Items": [
      { "Id": 1, "Label": "Contatti Piano Terra" },
      { "Id": 2, "Label": "Contatti Primo Piano" },
      { "Id": 3, "Label": "Radar Piano Terra" },
      { "Id": 4, "Label": "Radar Primo Piano" }
    ],
    "Groups": [
      { "Id": "contatti", "Label": "Contatti", "PartitionIds": [1, 2] },
      { "Id": "radar", "Label": "Radar", "PartitionIds": [3, 4] },
      { "Id": "piano_terra", "Label": "Piano Terra", "PartitionIds": [1, 3] },
      { "Id": "primo_piano", "Label": "Primo Piano", "PartitionIds": [2, 4] }
    ]
  },
  "Mqtt": {
    "BrokerHost": "localhost",
    "BrokerPort": 1883,
    "Username": null,
    "Password": null,
    "ClientId": "digiplex",
    "TopicPrefix": "digiplex",
    "EnableHomeAssistantDiscovery": true,
    "HomeAssistantDiscoveryPrefix": "homeassistant"
  }
}
