{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "remoteHost",
      "type": "promptString",
      "description": "Remote host (IP or hostname)",
      "default": "192.168.1.100"
    },
    {
      "id": "remoteUser",
      "type": "promptString",
      "description": "SSH user on remote host",
      "default": "root"
    }
  ],
  "tasks": [
    {
      "label": "sync-remote-mkdir",
      "type": "shell",
      "command": "ssh",
      "args": [
        "${input:remoteUser}@${input:remoteHost}",
        "mkdir -p ~/digiplex2mqtt/mosquitto"
      ],
      "problemMatcher": [],
      "detail": "Create remote directory structure"
    },
    {
      "label": "sync-remote",
      "type": "shell",
      "command": "rsync",
      "args": [
        "-av",
        "docker-compose.yml",
        "mosquitto/",
        ".env",
        "${input:remoteUser}@${input:remoteHost}:~/digiplex2mqtt/"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "sync-remote-mkdir",
      "problemMatcher": [],
      "detail": "Sync compose and config files to remote server"
    },
    {
      "label": "deploy-remote",
      "type": "shell",
      "command": "ssh",
      "args": [
        "${input:remoteUser}@${input:remoteHost}",
        "cd ~/digiplex2mqtt && docker compose pull && docker compose up -d"
      ],
      "dependsOn": "sync-remote",
      "problemMatcher": [],
      "group": "build",
      "detail": "Sync files, pull images and restart on remote server"
    },
    {
      "label": "remote-logs",
      "type": "shell",
      "command": "ssh",
      "args": [
        "${input:remoteUser}@${input:remoteHost}",
        "docker logs -f ~/digiplex2mqtt/digiplex"
      ],
      "problemMatcher": [],
      "isBackground": true,
      "detail": "Stream logs from the remote digiplex container"
    },
    {
      "label": "remote-shell",
      "type": "shell",
      "command": "ssh",
      "args": [
        "-t",
        "${input:remoteUser}@${input:remoteHost}",
        "docker exec -it digiplex /bin/bash"
      ],
      "problemMatcher": [],
      "detail": "Open a shell in the remote digiplex container"
    }
  ]
}
