# Docker image tag: "latest", "debug", or a specific version like "0.1.0-ci.5"
IMAGE_TAG=latest

# Serial connection
SERIAL_DEVICE=/dev/ttyUSB0
SERIAL_PASSWORD=0000
SERIAL_BAUD_RATE=19200
SERIAL_POLL_INTERVAL_MS=1000

# Set to "true" to use mock serial (no hardware needed)
USE_MOCK=false

# MQTT broker - point to your existing broker, or use the bundled mosquitto profile
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=digiplex
MQTT_HA_DISCOVERY=true

# Only used when running with mosquitto profile: docker compose --profile mosquitto up
MQTT_PORT=1883
